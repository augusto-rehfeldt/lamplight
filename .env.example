# Copy to .env. Everything is optional: keys can also be entered in the game's
# AI setup screen, where they stay in memory and are never saved.

# Key for the provider configured in AI setup (alternative to typing it in).
LAMPLIGHT_AI_KEY=

# Browser build and writing engine: OpenAI-compatible provider settings.
AW_API_KEY=
AW_BASE_URL=https://hyper.charm.land/v1
AW_MODEL_PRO=qwen3.8-max
AW_MODEL_FLASH=deepseek-v4-pro-0813
AW_TIMEOUT=300

# Preload the AW_* provider when launching the Godot client (same as --hyper).
LAMPLIGHT_AUTO_HYPER=0
